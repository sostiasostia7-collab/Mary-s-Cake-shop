<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mary's Cake - Final Project</title>
    <style>
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #3a2e2b;
            color: white;
            text-align: center;
            padding: 2rem;
        }
        header h1 {
            margin: 0;
            letter-spacing: 2px;
        }
        .container {
            max-width: 900px;
            margin: 20px auto;
            background: white;
            padding: 20px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
            border-radius: 8px;
        }
        .section-title {
            text-align: center;
            color: #5a3d31;
            border-bottom: 2px solid #eee;
            padding-bottom: 10px;
            margin-top: 30px;
        }
        .menu-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }
        .menu-item {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 6px;
            padding: 15px;
            text-align: center;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .menu-item h3 {
            margin: 10px 0 5px;
            color: #4a2e18;
        }
        .price {
            font-weight: bold;
            color: #b15d2e;
            font-size: 1.1rem;
        }
        .alert-box {
            background-color: #fff3cd;
            border: 1px solid #ffeeba;
            color: #856404;
            padding: 15px;
            border-radius: 5px;
            margin-top: 20px;
        }
        .checkout-box {
            background: #fdfbf7;
            border: 1px dashed #b15d2e;
            padding: 20px;
            border-radius: 6px;
            margin-top: 30px;
        }
        .checkout-box table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }
        .checkout-box th, .checkout-box td {
            padding: 8px 12px;
            text-align: left;
            border-bottom: 1px solid #ddd;
        }
        .total {
            text-align: right;
            font-size: 1.2rem;
            font-weight: bold;
            margin-top: 15px;
            color: #3a2e2b;
        }
    </style>
</head>
<body>

    <header>
        <h1>MARY'S CAKE</h1>
        <p>Flavors of France - Dine with us</p>
    </header>

    <div class="container">
        
        <!-- MENU SECTION -->
        <h2 class="section-title">OUR MENU</h2>
        <div class="menu-grid">
            <div class="menu-item">
                <h3>Chocolate Cake</h3>
                <p>Experience the rich, moist, and delicious taste of our Chocolate Cake!</p>
                <div class="price">₱55</div>
            </div>
            <div class="menu-item">
                <h3>Ube Cake</h3>
                <p>Rich in delicious ube flavor, creamy, and irresistibly yummy!</p>
                <div class="price">₱55</div>
            </div>
            <div class="menu-item">
                <h3>Chiffon Cake</h3>
                <p>Light, soft, fluffy, and perfectly delightful for every occasion!</p>
                <div class="price">₱50</div>
            </div>
        </div>

        <!-- LOW STOCK ALERT SECTION -->
        <div class="alert-box">
            <h3>⚠️ LOW STOCK ALERT</h3>
            <ul>
                <li><strong>Ube Cake:</strong> 2 pcs left</li>
                <li><strong>Chiffon Cake:</strong> 3 pcs left</li>
                <li><strong>Chocolate Cake:</strong> 1 pc left</li>
            </ul>
        </div>

        <!-- CHECKOUT SUMMARY SECTION -->
        <div class="checkout-box">
            <h3>SWEET MARY'S CAKE - [CHECK OUT]</h3>
            <table>
                <tr>
                    <th>Qty & Item</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
                <tr>
                    <td>1x Chocolate Cake</td>
                    <td>₱55</td>
                    <td>[X]</td>
                </tr>
                <tr>
                    <td>2x Ube Cake</td>
                    <td>₱55</td>
                    <td>[X]</td>
                </tr>
                <tr>
                    <td>1x Chiffon Cake</td>
                    <td>₱50</td>
                    <td>[X]</td>
                </tr>
            </table>
            <div class="total">
                Total: ₱160
            </div>
        </div>

    </div>

</body>
</html>